{
  "$description": "workshop-dto design tokens. Measured from reference/hero_section.png and reference/task.png; mirrored by the Figma file HAuazsHk1Uw3NPQoOdJmSW and documented in DESIGN.md. Change all three together.",
  "color": {
    "$description": "Primitives. Do not reference these from a component or screen — use the semantic group. The code group is the one exception.",
    "neutral": {
      "black":    { "$value": "#0a0a0a", "$type": "color", "$description": "Display headlines, exercise titles, primary labels" },
      "900":      { "$value": "#131319", "$type": "color", "$description": "Locked-step labels, code punctuation" },
      "700":      { "$value": "#373c46", "$type": "color", "$description": "Long-form body copy" },
      "600":      { "$value": "#494a57", "$type": "color", "$description": "Trailing metadata, inline code tags" },
      "500":      { "$value": "#66656e", "$type": "color", "$description": "Editor gutter, chevrons, secondary glyphs" },
      "400":      { "$value": "#9aa0a6", "$type": "color", "$description": "Disabled labels, lock glyphs, info glyph" },
      "300":      { "$value": "#dcdcde", "$type": "color", "$description": "Card borders on the hero canvas, dashed connectors" },
      "200":      { "$value": "#ececee", "$type": "color", "$description": "Card borders inside the app window" },
      "100":      { "$value": "#f6f6f6", "$type": "color", "$description": "Hero page canvas" },
      "50":       { "$value": "#fafafa", "$type": "color", "$description": "Recessed strips — hero cards, editor gutter and tab bar" },
      "white":    { "$value": "#ffffff", "$type": "color", "$description": "Pure white, avatar and badge text" },
      "app":      { "$value": "#f9f8fa", "$type": "color", "$description": "Viewport behind the app window" },
      "surface":  { "$value": "#fefefe", "$type": "color", "$description": "The app window and every card inside it" },
      "disabled": { "$value": "#e4e5e8", "$type": "color", "$description": "Disabled button fill, avatar fill" }
    },
    "blue": {
      "700": { "$value": "#0b3fd0", "$type": "color", "$description": "Pressed accent" },
      "600": { "$value": "#1e62fd", "$type": "color", "$description": "Accent Blue — the system's one attention colour" },
      "500": { "$value": "#5b8dfe", "$type": "color", "$description": "Hover accent" },
      "300": { "$value": "#a8c2fd", "$type": "color", "$description": "Decorative connector nodes" },
      "100": { "$value": "#dbe5fe", "$type": "color", "$description": "Accent border on tinted surfaces" },
      "50":  { "$value": "#eef1fd", "$type": "color", "$description": "Accent wash behind icon badges" }
    },
    "navy": {
      "900": { "$value": "#02205a", "$type": "color", "$description": "Action Navy — primary button only" },
      "800": { "$value": "#00267e", "$type": "color", "$description": "Type names in code" }
    },
    "lavender": {
      "300": { "$value": "#cfd2ec", "$type": "color", "$description": "Illustration tint" },
      "100": { "$value": "#e6e8f7", "$type": "color", "$description": "Illustration tint, lightest" }
    },
    "code": {
      "$description": "Syntax colours. Bound directly because syntax is not a UI role.",
      "keyword":     { "$value": "#5b21d6", "$type": "color", "$description": "export, type, class, def, public" },
      "type":        { "$value": "#00267e", "$type": "color", "$description": "Declared type and class names" },
      "identifier":  { "$value": "#131319", "$type": "color", "$description": "Fields, variables" },
      "comment":     { "$value": "#7d7f8b", "$type": "color", "$description": "// TODO: starter hints" },
      "punctuation": { "$value": "#131319", "$type": "color", "$description": "Braces, operators" },
      "linenumber":  { "$value": "#66656e", "$type": "color", "$description": "Gutter numerals" }
    }
  },
  "semantic": {
    "$description": "The only colour names a component or screen may bind.",
    "bg": {
      "canvas":         { "$value": "{color.neutral.100}",      "$type": "color", "$description": "Hero page background" },
      "app":            { "$value": "{color.neutral.app}",      "$type": "color", "$description": "Viewport behind the app window" },
      "surface":        { "$value": "{color.neutral.surface}",  "$type": "color", "$description": "App window, every card, editor body" },
