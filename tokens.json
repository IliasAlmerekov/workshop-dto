    "body-question":       { "$value": { "fontFamily": "Inter", "fontSize": "19px",  "fontWeight": 400, "lineHeight": 1.45, "letterSpacing": "-0.5px"  }, "$type": "typography", "$description": "Exercise question line" },
    "body-language":       { "$value": { "fontFamily": "Inter", "fontSize": "24px",  "fontWeight": 400, "lineHeight": 1.3,  "letterSpacing": "-0.3px"  }, "$type": "typography", "$description": "Track card label" },
    "body-default":        { "$value": { "fontFamily": "Inter", "fontSize": "16px",  "fontWeight": 400, "lineHeight": 1.44, "letterSpacing": "0px"     }, "$type": "typography", "$description": "Selector label, generic body" },
    "body-default-medium": { "$value": { "fontFamily": "Inter", "fontSize": "16px",  "fontWeight": 500, "lineHeight": 1.44, "letterSpacing": "0px"     }, "$type": "typography", "$description": "Secondary and disabled button label" },
    "body-default-bold":   { "$value": { "fontFamily": "Inter", "fontSize": "16px",  "fontWeight": 700, "lineHeight": 1.44, "letterSpacing": "0px"     }, "$type": "typography", "$description": "Primary button, active step" },
    "body-small":          { "$value": { "fontFamily": "Inter", "fontSize": "15px",  "fontWeight": 400, "lineHeight": 1.53, "letterSpacing": "0px"     }, "$type": "typography", "$description": "Intro paragraph, task sentence, file tab" },
    "body-small-medium":   { "$value": { "fontFamily": "Inter", "fontSize": "15px",  "fontWeight": 500, "lineHeight": 1.5,  "letterSpacing": "0px"     }, "$type": "typography", "$description": "Step numerals, avatar initials" },
    "body-compact":        { "$value": { "fontFamily": "Inter", "fontSize": "14px",  "fontWeight": 400, "lineHeight": 1.5,  "letterSpacing": "-0.1px"  }, "$type": "typography", "$description": "Trailing metadata" },
    "body-compact-bold":   { "$value": { "fontFamily": "Inter", "fontSize": "14px",  "fontWeight": 700, "lineHeight": 1.4,  "letterSpacing": "-0.3px"  }, "$type": "typography", "$description": "Context panel row titles" },
    "body-panel":          { "$value": { "fontFamily": "Inter", "fontSize": "12.5px","fontWeight": 400, "lineHeight": 1.5,  "letterSpacing": "-0.3px"  }, "$type": "typography", "$description": "Context panel copy, validation note" },
    "label-eyebrow":       { "$value": { "fontFamily": "Inter", "fontSize": "15px",  "fontWeight": 700, "lineHeight": 1.2,  "letterSpacing": "0.2px"   }, "$type": "typography", "$description": "Uppercase eyebrows and section labels" },
    "label-caption":       { "$value": { "fontFamily": "Inter", "fontSize": "13px",  "fontWeight": 400, "lineHeight": 1.4,  "letterSpacing": "0.1px"   }, "$type": "typography", "$description": "Documentation captions" },
    "label-caption-bold":  { "$value": { "fontFamily": "Inter", "fontSize": "13px",  "fontWeight": 700, "lineHeight": 1.4,  "letterSpacing": "0.1px"   }, "$type": "typography", "$description": "Documentation captions, emphasised" },
    "label-field-chip":    { "$value": { "fontFamily": "Inter", "fontSize": "13px",  "fontWeight": 600, "lineHeight": 1.3,  "letterSpacing": "-0.1px"  }, "$type": "typography", "$description": "Field contract chips" },
