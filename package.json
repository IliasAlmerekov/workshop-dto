{
  "name": "workshop-dto",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "docker compose up --build api",
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "lint:web": "pnpm --filter web lint",
    "typecheck:web": "pnpm --filter web typecheck",
    "test:web": "pnpm --filter web test",
    "format:web": "pnpm --filter web format",
    "format:check:web": "pnpm --filter web format:check",
    "dev:deck": "pnpm --filter deck dev",
    "build:deck": "pnpm --filter deck build",
    "typecheck:deck": "pnpm --filter deck typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
