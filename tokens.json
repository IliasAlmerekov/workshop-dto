    "code-inline":         { "$value": { "fontFamily": "JetBrains Mono", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.5,  "letterSpacing": "0px" }, "$type": "typography", "$description": "Type names inside prose" },
    "code-gutter":         { "$value": { "fontFamily": "JetBrains Mono", "fontSize": "13px", "fontWeight": 400, "lineHeight": 2.0,  "letterSpacing": "0px" }, "$type": "typography", "$description": "Line numbers" }
  },
