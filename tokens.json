      "accent-subtle":  { "$value": "{color.blue.50}",          "$type": "color", "$description": "Icon badge wash" },
      "accent":         { "$value": "{color.blue.600}",         "$type": "color", "$description": "Active step badge, active underline, brand dot" },
      "action":         { "$value": "{color.navy.900}",         "$type": "color", "$description": "Primary button — nothing else" },
      "disabled":       { "$value": "{color.neutral.disabled}", "$type": "color", "$description": "Disabled button" }
    },
    "text": {
      "primary":   { "$value": "{color.neutral.black}", "$type": "color", "$description": "Headlines, titles, active labels" },
      "secondary": { "$value": "{color.neutral.700}",   "$type": "color", "$description": "Body copy" },
      "subtle":    { "$value": "{color.neutral.500}",   "$type": "color", "$description": "Gutter, chevrons, app-bar eyebrow" },
      "muted":     { "$value": "{color.neutral.400}",   "$type": "color", "$description": "Disabled text, lock glyphs" },
      "accent":    { "$value": "{color.blue.600}",      "$type": "color", "$description": "EXERCISE 01, field chips, the ampersand" },
      "inverse":   { "$value": "{color.neutral.white}", "$type": "color", "$description": "Text on Action Navy and Accent Blue" }
    },
    "border": {
      "default": { "$value": "{color.neutral.200}", "$type": "color", "$description": "Every border inside the app window" },
      "strong":  { "$value": "{color.neutral.300}", "$type": "color", "$description": "Hero card borders, dashed connectors" },
      "accent":  { "$value": "{color.blue.600}",    "$type": "color", "$description": "Focus and selected outlines" }
    }
  },
  "font": {
    "inter": {
      "$value": "Inter",
      "$type": "fontFamily",
      "$description": "Interface typeface. Weights 400/500/600/700, loaded from Google Fonts. Tracking is size-dependent — always take it from the matching typography token. The reference PNGs were rendered in a narrower system grotesque, so the ramp below tunes Inter's size and tracking to occupy the same footprint rather than switching fonts."
    },
    "mono": {
      "$value": "JetBrains Mono",
      "$type": "fontFamily",
      "$description": "Code typeface — editor body, gutter, inline type names. The one deliberate addition to a single-typeface system, because the workshop is a code-reading surface. Do not extend it to UI labels."
    }
  },
  "typography": {
    "display-hero":        { "$value": { "fontFamily": "Inter", "fontSize": "137px", "fontWeight": 700, "lineHeight": 1.0,  "letterSpacing": "-6.8px"  }, "$type": "typography", "$description": "WORKSHOP" },
    "display-sub":         { "$value": { "fontFamily": "Inter", "fontSize": "100px", "fontWeight": 700, "lineHeight": 1.0,  "letterSpacing": "-4.58px" }, "$type": "typography", "$description": "DTO&Mapping" },
